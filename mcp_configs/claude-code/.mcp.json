{
  // Claude Code — project-scoped MCP config.
  // Place at project root as `.mcp.json` (or merge into `~/.claude.json` for user scope).
  // `${MCP_DIR}` = absolute path to the folder containing the MCP server .py scripts.
  // Generate automatically:  python setup_universal.py --mcp-dir <MCP_DIR> --client claude
  "mcpServers": {
    "memory": {
      "command": "python",
      "args": ["${MCP_DIR}/memory_mcp.py"],
      "env": { "MAST_CONFIG": "${MCP_DIR}" }
    },
    "shell": {
      "command": "python",
      "args": ["${MCP_DIR}/shell_mcp.py"],
      "env": { "MAST_CONFIG": "${MCP_DIR}" }
    },
    "file": {
      "command": "python",
      "args": ["${MCP_DIR}/file_mcp.py"],
      "env": { "MAST_CONFIG": "${MCP_DIR}" }
    },
    "research": {
      "command": "python",
      "args": ["${MCP_DIR}/research_mcp.py"],
      "env": { "MAST_CONFIG": "${MCP_DIR}" }
    },
    "browser": {
      "command": "python",
      "args": ["${MCP_DIR}/browser_mcp.py"],
      "env": { "MAST_CONFIG": "${MCP_DIR}" }
    }
  }
}