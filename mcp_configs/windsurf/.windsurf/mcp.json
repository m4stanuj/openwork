{
  // Windsurf — project-scoped MCP config.
  // Place at project root as `.windsurf/mcp.json`.
  // Global (all projects):  ~/.codeium/windsurf/mcp_config.json  (same shape).
  // Generate automatically:  python setup_universal.py --mcp-dir <MCP_DIR> --client windsurf
  "mcpServers": {
    "memory": {
      "command": "python",
      "args": ["${MCP_DIR}/memory_mcp.py"],
      "env": { "MAST_CONFIG": "${MCP_DIR}" }
    },
    "shell": {
      "command": "python",
      "args": ["${MCP_DIR}/shell_mcp.py"],
      "env": { "MAST_CONFIG": "${MCP_DIR}" }
    },
    "file": {
      "command": "python",
      "args": ["${MCP_DIR}/file_mcp.py"],
      "env": { "MAST_CONFIG": "${MCP_DIR}" }
    },
    "research": {
      "command": "python",
      "args": ["${MCP_DIR}/research_mcp.py"],
      "env": { "MAST_CONFIG": "${MCP_DIR}" }
    },
    "browser": {
      "command": "python",
      "args": ["${MCP_DIR}/browser_mcp.py"],
      "env": { "MAST_CONFIG": "${MCP_DIR}" }
    }
  }
}