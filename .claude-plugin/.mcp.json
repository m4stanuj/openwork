{
  // Claude Code plugin — MCP servers.
  // This is a THIN layer over the standard MCP servers. The core logic lives in
  // the plain MCP server scripts (see setup_universal.py / mcp_configs/).
  // ${MCP_DIR} = absolute path to the folder containing the MCP server .py scripts.
  "mcpServers": {
    "memory": {
      "command": "python",
      "args": ["${MCP_DIR}/memory_mcp.py"],
      "env": { "MAST_CONFIG": "${MCP_DIR}" }
    },
    "shell": {
      "command": "python",
      "args": ["${MCP_DIR}/shell_mcp.py"],
      "env": { "MAST_CONFIG": "${MCP_DIR}" }
    },
    "file": {
      "command": "python",
      "args": ["${MCP_DIR}/file_mcp.py"],
      "env": { "MAST_CONFIG": "${MCP_DIR}" }
    },
    "research": {
      "command": "python",
      "args": ["${MCP_DIR}/research_mcp.py"],
      "env": { "MAST_CONFIG": "${MCP_DIR}" }
    },
    "browser": {
      "command": "python",
      "args": ["${MCP_DIR}/browser_mcp.py"],
      "env": { "MAST_CONFIG": "${MCP_DIR}" }
    }
  }
}